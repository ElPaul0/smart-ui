# === storcli (required on the RAID host) ===
STORCLI_PATH=/opt/MegaRAID/storcli/storcli64
STORCLI_CONTROLLER=0

# === Web UI ===
LISTEN_HOST=0.0.0.0
LISTEN_PORT=7001
SITE_TITLE=Disk Monitor
# UI defaults (users can still switch in the browser; choice is saved in localStorage)
DEFAULT_LANG=en
DEFAULT_THEME=dark
# UI auto-refresh default: 10 | 30 | 60 | 120 (seconds)
DEFAULT_REFRESH_SEC=30

# Background poll for ntfy alerts (seconds, min 15)
POLL_SEC=60

# === Data (persistent across app updates) ===
# Host install example: /var/lib/smart-ui/events.db
SMART_UI_DB=./events.db

# === Notifications language (server-side ntfy / event log) ===
NOTIFY_LANG=en

# === Optional ntfy (dedicated topic recommended, e.g. .../disk-alerts) ===
# NTFY_URL=https://ntfy.example.com/disk-alerts
# NTFY_USER=
# NTFY_PASS=
# NTFY_TITLE=Disks
